# ---------------------------------------------------------------------------
# Growth-engine environment (secrets + safety posture). Copy to .env.local —
# the tick and the dashboard both read it. Product identity/repos/site layout
# live in product/product.json (NOT here); a few env overrides below exist
# for ops flexibility. The product and its website get NO new env vars from
# this engine.
# ---------------------------------------------------------------------------

# Where the product config lives (product.json + factbase/). Default: ./product
# PRODUCT_DIR=
# Dashboard port (also read by deploy/open-dashboard.sh). Default: 3400.
# Give every engine instance on this machine its own port.
# PORT=3400

# --- Global safety (defense in depth) ---------------------------------------
# Hard stop checked before the DB is even touched. "1" = the whole engine is OFF.
GROWTH_HALT=0
# Default posture. "true" = generate + guardrail + build payload, but DO NOT
# call any external API (writes the would-be payload to audit_log instead).
DRY_RUN=true
# Per-channel live overrides, used to flip ONE channel live at a time during
# rollout while everything else stays in dry-run. Comma-separated channel list.
# e.g. LIVE_CHANNELS=changelog,blog  then later add mastodon,bluesky ...
LIVE_CHANNELS=

# --- Auth for the OPTIONAL HTTP routes --------------------------------------
# Only exercised if the /api/cron/* and /api/admin/* routes are deployed and
# called over HTTP; the local tick + dashboard don't use them.
CRON_SECRET=
ADMIN_TOKEN=

# --- Database ---------------------------------------------------------------
# Any Postgres connection string (Neon / local). Required. One database per
# engine instance — dedupe keys, rate buckets, and kill switches are global
# within a database, so two products must NOT share one.
DATABASE_URL=postgres://localhost:5432/growth_engine

# --- Claude content generation (via the Claude Code CLI: `claude -p`) -------
# No ANTHROPIC_API_KEY needed — the `claude` CLI uses its own existing auth
# (subscription login / CLAUDE_CODE_OAUTH_TOKEN / or an API key if the host
# environment already has one). The `claude` binary MUST exist + be
# authenticated in whatever runtime executes the AI crons (NOT Vercel
# serverless — see SETUP.md "AI runtime").
# CLAUDE_BIN=claude
# CLAUDE_GEN_MODEL=sonnet
# CLAUDE_CRITIC_MODEL=haiku
# CLAUDE_TIMEOUT_MS=240000
# CLAUDE_CLI_EXTRA_ARGS=--strict-mcp-config

# --- GitHub (read releases, commit content into the website repo) -----------
# Prefer a fine-grained PAT / GitHub App token scoped to:
#   - read  contents on the releases repo   (product.json github.releasesRepo)
#   - write contents on the website repo    (product.json github.websiteRepo)
GITHUB_TOKEN=

# Ops overrides for product.json (normally leave unset — product.json rules):
# GITHUB_RELEASES_REPO=
# GITHUB_WEBSITE_REPO=
# GITHUB_WEBSITE_BRANCH=
# SITE_URL=

# --- Social (Phase 3 — keep blank until rollout) ----------------------------
# Mastodon
MASTODON_BASE_URL=
MASTODON_ACCESS_TOKEN=
# Bluesky
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
# LinkedIn (phase 3)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
# Reddit (phase 3, conservative)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_USER_AGENT=growth-engine/0.1
REDDIT_SUBREDDITS=
# X / Twitter — write API is PAID. Client exists but stays disabled.
X_BEARER_TOKEN=
